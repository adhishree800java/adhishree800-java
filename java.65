class Solution {
    public boolean isNumber(String s) {
        
        boolean digit = false;
        boolean dot = false;
        boolean exponent = false;
        boolean expDigit = true;

        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);

            // Digit
            if (c >= '0' && c <= '9') {
                digit = true;

                if (exponent) {
                    expDigit = true;
                }
            }

            // + or -
            else if (c == '+' || c == '-') {
                // Sign is allowed only at the beginning
                // or immediately after e/E
                if (i != 0 && s.charAt(i - 1) != 'e' && s.charAt(i - 1) != 'E') {
                    return false;
                }
            }

            // Dot
            else if (c == '.') {
                // Only one dot and no dot after e/E
                if (dot || exponent) {
                    return false;
                }

                dot = true;
            }

            // e or E
            else if (c == 'e' || c == 'E') {
                // Only one exponent and must have a number before it
                if (exponent || !digit) {
                    return false;
                }

                exponent = true;
                expDigit = false;
            }

            // Any other character
            else {
                return false;
            }
        }

        return digit && expDigit;
    }
}
