class Solution {
    public void sortColors(int[] nums) {
        int low = 0;
        int mid = 0;
        int high = nums.length - 1;

        while (mid <= high) {
            if (nums[mid] == 0) {
                // Found a 0 (Red): swap it to the left boundary
                swap(nums, low, mid);
                low++;
                mid++;
            } else if (nums[mid] == 1) {
                // Found a 1 (White): already in the correct relative middle position
                mid++;
            } else { // nums[mid] == 2
                // Found a 2 (Blue): swap it to the right boundary
                swap(nums, mid, high);
                high--;
                // Do not increment mid here because the swapped element from high needs evaluation
            }
        }
    }

    private void swap(int[] nums, int i, int j) {
        int temp = nums[i];
        nums[i] = nums[j];
        nums[j] = temp;
    }
}
